# .env.example — minimal single-instance config
#
# This file is OPTIONAL. The normal path is to run `gitlab-cli` and let
# the wizard ask for what it needs; the token is then stored in
# ~/.gitlab-cli/env with mode 600, not here.
#
# Use this only when you want one simple GitLab instance, or when
# running inside CI or a script.
#
#   cp .env.example .env
#
# WARNING: .env is in .gitignore — never commit it.

GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your-token-here
MASTER_DIR=MasterGroups
